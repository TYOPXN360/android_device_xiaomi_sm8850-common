type hal_visdisplaysrv_default, domain;
type hal_visdisplaysrv_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_visdisplaysrv_default)
binder_use(hal_visdisplaysrv_default)
vndbinder_use(hal_visdisplaysrv_default)

# The service talks to SurfaceFlinger and the graphics allocator to hand over
# the processed stream.
hal_client_domain(hal_visdisplaysrv_default, hal_graphics_allocator)
hal_client_domain(hal_visdisplaysrv_default, hal_graphics_composer)

# It registers vendor.novatek.hardware.visdisplaysrv/default with vndservicemanager.
add_service(hal_visdisplaysrv_default, visdisplaysrv_service)

# The panel link is a SPI device created by the driver at boot; the rc file
# chmods it 0666 so the HAL can map it.
allow hal_visdisplaysrv_default nvt_device:chr_file rw_file_perms;

# Reads the DQE scene tables that live on odm.
r_dir_file(hal_visdisplaysrv_default, vendor_configs_file)
allow hal_visdisplaysrv_default vendor_file:file r_file_perms;

# Scratch space for the frame buffers it shares with the composer.
allow hal_visdisplaysrv_default vendor_display_vendor_data_file:dir create_dir_perms;
allow hal_visdisplaysrv_default vendor_display_vendor_data_file:file create_file_perms;
