type hal_visdisplaysrv_default, domain;
type hal_visdisplaysrv_default_exec, exec_type, file_type, vendor_file_type;
type hal_visdisplaysrv_service, hal_service_type, protected_service, service_manager_type;
type vendor_hal_framecapturemanager_xiaomi_service, hal_service_type, service_manager_type;

# The Novatek visual display processor. It links libframemaster and
# libframecapturemanager but only publishes its own IVisdisplaysrv interface -
# the audit log shows vendor_hal_displayfeature_xiaomi_default doing the
# addService for FrameMaster and FrameCaptureManager. What this HAL owns is the
# ASIC itself: it reads the scene tables from ASICScene.xml and programs the
# panel over SPI.
init_daemon_domain(hal_visdisplaysrv_default)
binder_use(hal_visdisplaysrv_default)
vndbinder_use(hal_visdisplaysrv_default)

hal_client_domain(hal_visdisplaysrv_default, hal_graphics_allocator)
hal_client_domain(hal_visdisplaysrv_default, hal_graphics_composer)

add_service(hal_visdisplaysrv_default, hal_visdisplaysrv_service)

# The panel link is a SPI device created by the driver at boot; the rc file
# chmods it 0666 so the HAL can map it.
allow hal_visdisplaysrv_default nvt_device:chr_file rw_file_perms;

# The DQE scene tables (ASICScene.xml) live on odm.
r_dir_file(hal_visdisplaysrv_default, vendor_configs_file)
allow hal_visdisplaysrv_default vendor_file:file r_file_perms;

# Scratch space for the frame buffers it shares with the composer.
allow hal_visdisplaysrv_default vendor_display_vendor_data_file:dir create_dir_perms;
allow hal_visdisplaysrv_default vendor_display_vendor_data_file:file create_file_perms;

allow hal_visdisplaysrv_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_visdisplaysrv_default hal_graphics_allocator_service:service_manager find;
allow hal_visdisplaysrv_default hal_graphics_allocator_default_tmpfs:file rw_file_perms;
allow hal_visdisplaysrv_default input_device:dir r_dir_perms;
allow hal_visdisplaysrv_default input_device:chr_file rw_file_perms;

# It opens NETLINK_GENERIC sockets to watch the display driver's events.
allow hal_visdisplaysrv_default self:netlink_generic_socket create_socket_perms_no_ioctl;
allow hal_visdisplaysrv_default self:netlink_socket create_socket_perms_no_ioctl;

# The HAL waits for FrameMaster, which the display feature service publishes.
allow hal_visdisplaysrv_default vendor_hal_framemaster_xiaomi_service:service_manager find;
allow hal_visdisplaysrv_default vendor_hal_framecapturemanager_xiaomi_service:service_manager find;
