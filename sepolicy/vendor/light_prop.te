# The light HAL reads the rear light switch properties. system_public_prop does
# not cover a vendor HAL, and this rule cannot live in the system_ext policy
# because hal_light_default is not visible from there.
#
# Use get_prop rather than r_file_perms: r_file_perms carries ioctl and lock,
# which property types neverallow.
get_prop(hal_light_default, rear_light_prop)
