ro.vendor.display.frame_capture_manager.enable=true
ro.vendor.display.framemaster.enable=true
ro.vendor.display.gamehdr_qualitypriority.enable=true
ro.vendor.display.hyperos.miDualDPU_support=true
ro.vendor.display.idle_default_fps=60
ro.vendor.display.jarvisservice.enable=true
ro.vendor.display.qingshan_eyecare.enable=1
ro.vendor.display.quickidle.enable=true
ro.vendor.display.skip_idle_for_90hz=true
ro.vendor.display.uiservice_local_backup.enable=true
