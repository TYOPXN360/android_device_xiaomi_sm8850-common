<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/rear_light_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="rear_light_enable"
        android:title="@string/rear_light_master_title"
        android:summary="@string/rear_light_master_summary" />

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="rear_light_battery"
        android:title="@string/rear_light_battery_title"
        android:summary="@string/rear_light_battery_summary"
        android:dependency="rear_light_enable" />

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="rear_light_notify"
        android:title="@string/rear_light_notify_title"
        android:summary="@string/rear_light_notify_summary"
        android:dependency="rear_light_enable" />


    <DropDownPreference
        android:key="rear_light_color"
        android:title="@string/rear_light_color_title"
        android:summary="@string/rear_light_color_summary"
        android:entries="@array/rear_light_color_entries"
        android:entryValues="@array/rear_light_color_values"
        android:defaultValue=""
        android:dependency="rear_light_enable" />

    <DropDownPreference
        android:key="rear_light_period"
        android:title="@string/rear_light_period_title"
        android:summary="@string/rear_light_period_summary"
        android:entries="@array/rear_light_period_entries"
        android:entryValues="@array/rear_light_period_values"
        android:defaultValue="0"
        android:dependency="rear_light_enable" />

    <com.android.settingslib.widget.FooterPreference
        android:title="@string/rear_light_footer"
        android:selectable="false" />

</PreferenceScreen>
