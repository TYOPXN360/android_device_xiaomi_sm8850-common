rust_binary {
    name: "alsd",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["src/*.rs"],
    crate_root: "src/main.rs",
    init_rc: ["alsd.rc"],
    // Link the Rust standard library in statically: a vendor process may not
    // depend on the dylib, which lives on /system.
    prefer_rlib: true,
    rustlibs: [
        "vendor.xiaomi.sensor.citsensorservice-V1-rust",
        "libbinder_rs",
        "libandroid_logger",
        // android_logger implements the `log` facade; the crate itself has to be
        // linked as well or the info!/warn! calls compile away to nothing.
        "liblog_rust",
    ],
}
