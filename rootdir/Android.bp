prebuilt_etc {
    name: "fstab.qcom",
    src: "etc/fstab.qcom",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "charger_fstab.qcom",
    src: "etc/charger_fstab.qcom",
    vendor: true,
}

// init.rc imports this as /init.recovery.${ro.hardware}.rc, i.e. straight
// from the root of the recovery ramdisk. It must therefore be a prebuilt_root
// (prebuilt_etc always lands under etc/, and sub_dir "init" used to put it in
// /system/etc/init where that import cannot see it). When the import fails the
// whole file is skipped: the backlight stays at full brightness (screen
// blinding, and the panel overheats) and the touch panel never comes up.
prebuilt_root {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    install_in_root: true,
    recovery: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "etc/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.xiaomi.rc",
    src: "etc/init.xiaomi.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "etc/ueventd.qcom.rc",
    vendor: true,
}

mkdir {
    name: "product_vm-system_mountpoint",
    dir: "vm-system",
    product_specific: true,
}